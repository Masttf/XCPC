struct Manacher{
    string res;
    vector<int> p;
    Manacher(string s){
        res = "^";
        for(auto x : s){
            res += '#';
            res += x;
        }
        res += "#&";
        p.resize(res.size() + 1);
        run();
        // s = abc idx 0 1 2
        // res = ^#a#b#c#& idx 2 4 6
        // s_idx -> res_idx * 2 + 2
    }
    void run(){
        int len = res.size();
        int c = 0, r = 0;
        for(int i = 1; i < len; i++){
            if(i <= r){
                p[i] = min(p[2 * c - i], r - i);
            }
            while(res[i - p[i] - 1] == res[i + p[i] + 1])p[i]++;
            if(i + p[i] > r){
                c = i;
                r = i + p[i];
            }
        }
        return ;
    }
    pair<int, int> get(){
        int start = max_element(p.begin(), p.end()) - p.begin();
        int max_len = p[start];
        return {start, max_len};
        // (i - p[i]) / 2是回文起始点,字符串下标从0开始
        // s_li = (i - p[i] + 1) / 2 - 1
        // s_ri = (i + p[i]) / 2 - 1
    }
    bool check(int l, int r){
        int len = (r - l + 1);
        int center = (l + r) / 2;
        center = center * 2 + 2;
        if(len % 2 == 0)center++;
        return p[center] >= len;
    }
};
