{
    "configurations": [
        
        {
            "name": "Competitive Programming (g++-14)",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "LOCAL"
            ],
            "compilerPath": "/opt/homebrew/bin/g++-14",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "gcc-x64",
            "compilerArgs": [
                "-O2",
                "-Wall",
                "-Wextra",
                "-fsanitize=address,undefined",
                "-D_GLIBCXX_DEBUG",
                "-D_GLIBCXX_ASSERTIONS",
                "-D_FORTIFY_SOURCE=2",
                "-std=c++20",
                "-g"
            ]
        }
    ],
    "version": 4
}